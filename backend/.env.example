# ==============================================================================
# NEXUS ENTERPRISE AI BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server Runtime Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ==============================================================================
# Supabase Configuration
# Obtain from: Supabase Dashboard -> Project Settings -> API
# ==============================================================================
# Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anonymous API Key (Used for client-side or authenticated user JWT validation)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key

# Service Role Secret Key (HIGH PRIVILEGE: Bypasses RLS - STRICTLY SERVER-SIDE ONLY!)
# Used by backend workers to write to audit logs and ingest batch document vectors
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-role-secret

# ==============================================================================
# Dual Google Gemini API Keys Configuration
# Obtain from: Google AI Studio (https://aistudio.google.com/)
# ==============================================================================
# KEY 1: Dedicated to High-Speed, Lightweight Workloads (e.g., Gemini 1.5 Flash / 2.0 Flash)
# Used for quick summaries, query classifications, and simple intent parsing
GEMINI_API_KEY_1=AIzaSy...your-gemini-key-1-flash

# KEY 2: Dedicated to Complex, Multi-Step Reasoning Workloads (e.g., Gemini 1.5 Pro)
# Used for contract audits, financial discrepancy reconciliation, and complex code rollbacks
# Also acts as automatic failover if Key 1 hits rate limits (HTTP 429)
GEMINI_API_KEY_2=AIzaSy...your-gemini-key-2-pro

# Default Model Selection
MODEL_FAST=gemini-1.5-flash
MODEL_REASONING=gemini-1.5-pro

# Request Limits & Timeouts
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
